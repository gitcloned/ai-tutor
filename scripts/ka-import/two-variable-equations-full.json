      {
        "title": "Completing solutions to 2-variable equations",
        "kaSlug": "graphing-solutions-to-2-variable-linear-equations-1",
        "order": 4,
        "prerequisites": ["checking-ordered-pair-solutions-to-equations-2"],
        "misconceptions": [
          {
            "text": "Child assumes the first value in an ordered pair (x, y) is y, not x",
            "prereqConcept": "checking-ordered-pair-solutions-to-equations-1"
          },
          {
            "text": "Child cannot substitute a value for a variable in a two-variable equation",
            "prereqConcept": "2-variable-linear-equations-graphs"
          }
        ],

        "probingTree": {
          "_comment": "Entry question: x - 5y = -15, complete the pair ( ___, -2 ). Answer: x = -25",
          "entryQuestion": {
            "type": "perseus",
            "difficultyLevel": "mots",
            "perseusContent": {
              "content": "$x-5y=-15$\n\n**Complete the missing value in the solution to the equation.**\n\n$($[[☃ numeric-input 1]]$,\\ -2)$",
              "widgets": {
                "numeric-input 1": {
                  "type": "numeric-input",
                  "graded": true,
                  "options": {
                    "answers": [{ "status": "correct", "value": -25 }],
                    "labelText": "x ="
                  }
                }
              }
            }
          },
          "nodes": [
            {
              "probe": "In the pair ( ___, -2 ), what does -2 represent — is it the value of x or the value of y?",
              "idealAnswer": "y",

              "ifCorrect": {
                "type": "steps",
                "steps": [
                  {
                    "probe": "Right! So y = -2. Substitute y = -2 into x - 5×(-2) = -15. What does the left side simplify to?",
                    "idealAnswer": "x + 10",

                    "ifCorrect": {
                      "type": "steps",
                      "steps": [
                        {
                          "probe": "Great — so now you have x + 10 = -15. What is x?",
                          "idealAnswer": "-25",
                          "ifCorrect": { "type": "question" },
                          "ifWrong": {
                            "type": "inline",
                            "content": "To solve x + 10 = -15, subtract 10 from both sides:\n\nx + 10 - 10 = -15 - 10\nx = -25",
                            "thenAsk": {
                              "probe": "Now try: if x + 10 = -15, what is x?",
                              "idealAnswer": "-25",
                              "ifCorrect": { "type": "question" },
                              "ifWrong": {
                                "type": "teach",
                                "conceptId": "graphing-solutions-to-2-variable-linear-equations-1",
                                "title": "Completing solutions to 2-variable equations"
                              }
                            }
                          }
                        }
                      ]
                    },

                    "ifWrong": {
                      "type": "inline",
                      "content": "When y = -2, replace every y with -2:\n\nx - 5×(-2) = -15\n\nRemember: 5×(-2) = -10, and subtracting -10 is the same as adding 10.\n\nSo: x + 10 = -15",
                      "thenAsk": {
                        "probe": "Now that you know x + 10 = -15, what is x?",
                        "idealAnswer": "-25",
                        "ifCorrect": { "type": "question" },
                        "ifWrong": {
                          "type": "teach",
                          "conceptId": "graphing-solutions-to-2-variable-linear-equations-1",
                          "title": "Completing solutions to 2-variable equations"
                        }
                      }
                    }
                  }
                ]
              },

              "ifWrong": {
                "type": "steps",
                "steps": [
                  {
                    "probe": "Let's try something simpler. In x - 5y = -15, if x = 0, what is y?",
                    "idealAnswer": "3",

                    "ifCorrect": {
                      "_comment": "Child can substitute — doesn't know what ordered pair notation means",
                      "type": "teach",
                      "conceptId": "checking-ordered-pair-solutions-to-equations-1",
                      "title": "Solutions to 2-variable equations",
                      "thenAsk": {
                        "probe": "In the pair ( ___, -2 ), which value goes in the blank — x or y?",
                        "idealAnswer": "x",
                        "ifCorrect": {
                          "type": "steps",
                          "steps": [
                            {
                              "probe": "Exactly — x is the blank. We know y = -2. Substitute into x - 5y = -15 to find x.",
                              "idealAnswer": "-25",
                              "ifCorrect": { "type": "question" },
                              "ifWrong": {
                                "type": "teach",
                                "conceptId": "graphing-solutions-to-2-variable-linear-equations-1",
                                "title": "Completing solutions to 2-variable equations"
                              }
                            }
                          ]
                        },
                        "ifWrong": { "type": "question" }
                      }
                    },

                    "ifWrong": {
                      "_comment": "Child cannot substitute at all — needs foundational concept",
                      "type": "teach",
                      "conceptId": "2-variable-linear-equations-graphs",
                      "title": "Two-variable linear equations intro",
                      "thenAsk": {
                        "probe": "In x - 5y = -15, if x = 0, what is y?",
                        "idealAnswer": "3",
                        "ifCorrect": {
                          "type": "teach",
                          "conceptId": "checking-ordered-pair-solutions-to-equations-1",
                          "title": "Solutions to 2-variable equations"
                        },
                        "ifWrong": {
                          "type": "teach",
                          "conceptId": "algebra-foundations",
                          "title": "Algebra foundations"
                        }
                      }
                    }
                  }
                ]
              }
            }
          ]
        },

